diff --git a/common/lwindex.c b/common/lwindex.c
index 1850bb7..8c1e47c 100644
--- a/common/lwindex.c
+++ b/common/lwindex.c
@@ -1107,8 +1107,14 @@ static lwindex_helper_t* get_index_helper(lwindex_indexer_t* indexer, AVStream*
             if (codecpar->codec_id == AV_CODEC_ID_H264
                 && codecpar->extradata_size >= 8 /* 8 is the offset of the first byte of the first SPS in AVCConfigurationRecord. */
                 && codecpar->extradata[0] == 1 /* configurationVersion == 1 */
-                && helper->parser_ctx->parser && helper->parser_ctx->parser->split
+                && helper->parser_ctx->parser
+#if LIBAVCODEC_VERSION_MAJOR >= 62
+                /* AVCodecParser.split was removed in libavcodec 62+: skip the AVCC-extradata probe (TS inputs carry Annex-B extradata, so this branch is not needed there). */
+                && 0) {
+#else
+                && helper->parser_ctx->parser->split
                 && helper->parser_ctx->parser->split(helper->codec_ctx, codecpar->extradata + 8, codecpar->extradata_size - 8) <= 0) {
+#endif
                 /* Since a SPS shall have no start code and no its emulation,
                  * therefore, this stream is not encapsulated as byte stream format. */
                 helper->bsf = av_bsf_get_by_name("h264_mp4toannexb");
@@ -1288,12 +1294,20 @@ static int append_extradata_if_new(lwindex_helper_t* helper, AVCodecContext* ctx
     if (current.extradata == ctx->extradata) {
         AVCodecParserContext* parser_ctx = helper->parser_ctx;
         if (parser_ctx && parser_ctx->parser) {
+#if LIBAVCODEC_VERSION_MAJOR >= 62
+            if (0) { /* AVCodecParser.split removed: fall through to the bsf branch below. */
+#else
             if (parser_ctx->parser->split) {
+#endif
                 /* For H.264 stream without start codes, don't split extradata from pkt->data.
                  * Its extradata is stored as global header. so, pkt->data shall contain no extradata.
                  * Libavcodec may not remove meaningless data which precedes data actually needed for decoding,
                  * so get the offset to such significant data here to deduplicate extradata as much as possible. */
+#if LIBAVCODEC_VERSION_MAJOR >= 62
+                int extradata_size = 0; /* split removed; this whole branch is disabled above on libavcodec 62+. */
+#else
                 int extradata_size = helper->bsf ? 0 : parser_ctx->parser->split(ctx, pkt->data, pkt->size);
+#endif
                 if (extradata_size > 0) {
                     int offset = get_offset_to_significant_extradata(ctx, pkt);
                     current.extradata = pkt->data + (uintptr_t)offset;
diff --git a/common/lwlibav_video.c b/common/lwlibav_video.c
index 55fa516..2333c79 100644
--- a/common/lwlibav_video.c
+++ b/common/lwlibav_video.c
@@ -1147,10 +1147,19 @@ static uint32_t lwlibav_vfr2cfr(lwlibav_video_decode_handler_t* vdhp, lwlibav_vi
 static void handle_decoder_pix_fmt(AVCodecParameters* codecpar, const AVCodec* codec, enum AVPixelFormat pix_fmt)
 {
     assert(codecpar && codec);
+#if LIBAVCODEC_VERSION_MAJOR >= 62
+    /* AVCodec.pix_fmts was removed in libavcodec 62+: query the supported configs instead. */
+    const enum AVPixelFormat* supported_fmts = NULL;
+    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_PIX_FORMAT, 0, (const void**)&supported_fmts, NULL) == 0 && supported_fmts && supported_fmts[0] != AV_PIX_FMT_NONE)
+        codecpar->format = (int)avcodec_find_best_pix_fmt_of_list(supported_fmts, pix_fmt, 1, NULL);
+    else
+        codecpar->format = (int)pix_fmt;
+#else
     if (codec->pix_fmts)
         codecpar->format = (int)avcodec_find_best_pix_fmt_of_list(codec->pix_fmts, pix_fmt, 1, NULL);
     else
         codecpar->format = (int)pix_fmt;
+#endif
 }
 
