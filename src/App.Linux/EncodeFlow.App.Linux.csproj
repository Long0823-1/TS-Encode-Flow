<Project Sdk="Microsoft.NET.Sdk">
 <!-- Linux向けAvalonia GUI。Core/Workerと同じく net9.0-windows TFM + EnableWindowsTargeting で
      ビルドし、Linux上でそのまま実行する（Phase Aで確立した方式）。Windowsの publish.ps1 は
      このプロジェクトを参照しないため、Windowsビルドには影響しない。 -->
 <PropertyGroup>
  <OutputType>Exe</OutputType>
  <TargetFramework>net9.0-windows</TargetFramework>
  <EnableWindowsTargeting>true</EnableWindowsTargeting>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>TS-Encode-Flow-Linux</AssemblyName>
  <RootNamespace>EncodeFlow.App.Linux</RootNamespace>
  <Version>0.6.24</Version>
  <ApplicationTitle>TS Encode Flow</ApplicationTitle>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Avalonia" Version="11.3.23"/>
  <PackageReference Include="Avalonia.Desktop" Version="11.3.23"/>
  <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23"/>
  <PackageReference Include="Avalonia.Headless" Version="11.3.23"/>
  <ProjectReference Include="../Core/EncodeFlow.Core.csproj"/>
 </ItemGroup>
</Project>
