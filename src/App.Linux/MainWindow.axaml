<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:EncodeFlow.App.Linux"
        x:Class="EncodeFlow.App.Linux.MainWindow"
        x:DataType="local:MainViewModel"
        Title="TS Encode Flow" Width="1180" Height="760"
        DragDrop.AllowDrop="True">
 <Grid ColumnDefinitions="216,*" ColumnSpacing="24" Margin="20,20,28,16">
  <!-- 左レール: ブランド + セクション切替（B-2で各画面を追加） -->
  <Grid Grid.Column="0" RowDefinitions="100,*,60">
   <StackPanel Grid.Row="0" VerticalAlignment="Center">
    <TextBlock Text="録画TSを動画に" FontSize="17" FontWeight="Bold"/>
    <TextBlock Text="TS Encode Flow" FontSize="12" Foreground="Gray"/>
   </StackPanel>
   <ListBox Grid.Row="1" x:Name="NavList" ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" Background="Transparent"/>
   <TextBlock Grid.Row="2" Text="元のTSはそのまま" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom"/>
  </Grid>

  <!-- 本体 -->
  <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
   <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
    <StackPanel>
     <TextBlock Text="{Binding Section}" FontSize="28" FontWeight="Bold"/>
     <TextBlock Text="録画から変換まで、ひとつの流れに。" FontSize="13" Foreground="Gray"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <TextBlock Text="{Binding WorkerText}" VerticalAlignment="Center" FontSize="12"/>
     <Button Content="ワーカーを起動" Command="{Binding StartWorkerCommand}"/>
     <Button Content="＋ TSを追加" x:Name="AddFilesButton"/>
    </StackPanel>
   </Grid>

   <Border Grid.Row="1" BorderBrush="#D0D7E3" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding IsQueueSection}">
    <StackPanel Spacing="6">
     <TextBlock Text="現在のプリセット" FontSize="12" Foreground="Gray"/>
     <ComboBox ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset}" MinWidth="420">
      <ComboBox.ItemTemplate>
       <DataTemplate x:DataType="local:PresetOption">
        <TextBlock Text="{Binding Label}"/>
       </DataTemplate>
      </ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Text="{Binding PresetDetail}" FontSize="13"/>
     <TextBlock Text="{Binding Counts}" FontSize="13" Foreground="Gray"/>
    </StackPanel>
   </Border>

   <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsQueueSection}">
    <Button Content="処理を再開" Command="{Binding ResumeCommand}"/>
    <Button Content="新規開始を一時停止" Command="{Binding PauseCommand}"/>
    <Button Content="すべて中止" Command="{Binding CancelAllCommand}"/>
    <Button Content="履歴をクリア" Command="{Binding ClearHistoryCommand}"/>
   </StackPanel>

   <Panel Grid.Row="3">
    <ListBox ItemsSource="{Binding Rows}" IsVisible="{Binding IsQueueSection}" Background="Transparent">
     <ListBox.ItemTemplate>
      <DataTemplate x:DataType="local:JobRowViewModel">
       <Border BorderBrush="#D0D7E3" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
        <StackPanel Spacing="4">
         <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="Bold"/>
         </Grid>
         <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="Gray"/>
         <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6"/>
         <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Text="{Binding Percent}" FontSize="12" Foreground="Gray"/>
          <Button Grid.Column="2" Content="中止" IsVisible="{Binding CanCancel}"
                  Command="{Binding $parent[Window].DataContext.CancelJobCommand}" CommandParameter="{Binding}"/>
          <Button Grid.Column="3" Content="再試行" IsVisible="{Binding CanRetry}"
                  Command="{Binding $parent[Window].DataContext.RetryJobCommand}" CommandParameter="{Binding}"/>
         </Grid>
         <TextBlock Text="{Binding Message}" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="{Binding PlaceholderText}" IsVisible="{Binding !IsQueueSection}" FontSize="16" Foreground="Gray"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Panel>

   <TextBlock Grid.Row="3" Text=""/>
  </Grid>
  <TextBlock Grid.Column="1" Text="{Binding Toast}" FontSize="12" Foreground="Gray"
             VerticalAlignment="Bottom" Margin="0,0,0,0"/>
 </Grid>
</Window>
